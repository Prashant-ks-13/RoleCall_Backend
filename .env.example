# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
USER_DB_PASSWORD=change-me
JOB_DB_PASSWORD=change-me
APPLICATION_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me

# --- Kafka bootstrap (used by services, not by the broker itself) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:19092

# --- Eureka ---
EUREKA_HOSTNAME=eureka-server

# --- Config Server ---
CONFIG_SERVER_URI=http://config-server:8888

# --- api-gateway CORS (the Vite dev server origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- auth-service JWT signing keystore ---
# Leave JWT_KEYSTORE_PATH blank for local dev: auth-service generates an
# ephemeral RSA keypair at startup instead (logged as a warning). Every
# restart then invalidates previously issued tokens. Set a real PKCS12
# keystore path here for anything beyond local dev.
JWT_KEYSTORE_PATH=
JWT_KEYSTORE_PASSWORD=change-me
JWT_KEY_ALIAS=rolecall-auth
JWT_KEY_PASSWORD=change-me

# --- payment-service Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:5173/payments/success
STRIPE_CANCEL_URL=http://localhost:5173/payments/cancel
